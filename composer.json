{
    "name": "funct/funct",
    "description": "A PHP library with commonly used code blocks",
    "authors": [
        {
            "name": "Aurimas Niekis",
            "email": "aurimas@niekis.lt"
        }
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "Funct\\": "src"
        },
        "files": [
            "src/Collection.php",
            "src/General.php",
            "src/Invoke.php",
            "src/Object.php",
            "src/Strings.php"
        ]
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    }
}
